# This file is documentation only. The app now uses --dart-define so builds do
# not depend on a private .env asset being present.
API_URL=http://10.0.2.2:8080/api

# Google OAuth Web Client ID. Pass with --dart-define; this file is documentation only.
# flutter run -d chrome --dart-define=GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# PostgreSQL / Supabase PostgreSQL JDBC connection.
# For local development you may omit these values and the API will use H2 PostgreSQL mode.
DB_URL=jdbc:postgresql://localhost:5432/splitdebt
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Use a long random secret in every shared/staging/production environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_HOURS=168
PORT=8080
ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Google Sign-In: use the Web OAuth 2.0 Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Forgot password. In local development you may return the OTP in the API response.
# NEVER enable PASSWORD_RESET_DEV_RETURN_CODE in production.
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_DEV_RETURN_CODE=true

# Optional SMTP settings. Gmail example: smtp.gmail.com:587 + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
SMTP_STARTTLS=true

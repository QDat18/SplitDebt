# Configuration template for SplitDebt API

# Option 1: Supabase Connection Pooler (Recommended - supports IPv4 networks)
# Host format: aws-0-[region].pooler.supabase.com
# Port: 5432 (Session mode) or 6543 (Transaction mode)
# Username format: postgres.[PROJECT_REF]
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.zvgpxmzznstotmqfwjet
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD


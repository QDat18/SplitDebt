# Database (use a local database or your managed PostgreSQL pooler)
DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# JWT: generate a random secret of at least 32 bytes; never reuse this sample.
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# Comma-separated web origins. Native Android/iOS clients are not restricted by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin uses the GOOGLE_APPLICATION_CREDENTIALS environment variable.
FIREBASE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=PATH_TO_YOUR_FIREBASE_SERVICE_ACCOUNT_JSON

# OAuth Web client ID used to verify the audience of Google ID tokens.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

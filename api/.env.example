# PostgreSQL / Supabase PostgreSQL JDBC connection.
# For local development you may omit these values and the API will use H2 PostgreSQL mode.
DB_URL=jdbc:postgresql://localhost:5432/splitdebt
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Use a long random secret in every shared/staging/production environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_HOURS=168
PORT=8080
ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
